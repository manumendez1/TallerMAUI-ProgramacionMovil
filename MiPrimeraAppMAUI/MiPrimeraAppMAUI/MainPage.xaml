<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiPrimeraAppMAUI.MainPage"
    BackgroundColor="#F0F8FF">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="Bienvenido a MAUI"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="Blue" />

            <Entry
                x:Name="nombreEntry"
                Placeholder="Ingresa tu nombre"
                BackgroundColor="White"
                TextColor="Black"
                Margin="0,20" />

            <Button
                x:Name="saludarButton"
                Text="Saludar"
                Clicked="OnSaludarClicked"
                BackgroundColor="Green"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

            <Label
                x:Name="mensajeLabel"
                Text="Esperando saludo..."
                FontSize="20"
                HorizontalOptions="Center"
                TextColor="Gray" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>